# MySQL connection string (create a dedicated database + user for this app,
# e.g. via phpMyAdmin: create database `haji_portfolio` and a user with
# full privileges on it — do not reuse another project's DB credentials).
DATABASE_URL="mysql://username:password@127.0.0.1:3306/haji_portfolio"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js's own base URL for building sign-in/sign-out redirect links.
# Required in production behind a reverse proxy (Cloudflare, LiteSpeed,
# etc.) — without it, Auth.js tries to detect the host from request
# headers and can fall back to its default of http://localhost:3000 if
# the proxy doesn't forward a trustworthy Host header. Set this to the
# real deployed domain in production (no trailing slash); leave unset
# for local dev.
# AUTH_URL="https://haji.horooinnovations.com"

# Used only once by `npm run db:seed` to create the first admin login.
# Change the password immediately after first login.
ADMIN_SEED_NAME="Haji Omer"
ADMIN_SEED_EMAIL="hadjiomer9@gmail.com"
ADMIN_SEED_PASSWORD="ChangeThisPassword123!"

# Public site URL — used for canonical links, sitemap.xml, robots.txt and
# Open Graph/Twitter card URLs. Set this to the real deployed domain in
# production (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
