      "page": "/admin/blog/[id]",
      "regex": "^/admin/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/blog/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
